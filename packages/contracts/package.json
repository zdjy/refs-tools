{
  "name": "@refs-tools/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./media": {
      "types": "./src/media.ts",
      "development": "./src/media.ts",
      "import": "./dist/media.js"
    },
    "./authorization": {
      "types": "./src/authorization.ts",
      "development": "./src/authorization.ts",
      "import": "./dist/authorization.js"
    },
    "./audit": {
      "types": "./src/audit.ts",
      "development": "./src/audit.ts",
      "import": "./dist/audit.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "development": "./src/auth.ts",
      "import": "./dist/auth.js"
    },
    ".": {
      "types": "./src/common.ts",
      "development": "./src/common.ts",
      "import": "./dist/common.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "zod": "^4.1.12"
  }
}
