{
  "name": "basketball-referee-toolkit",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "brand:icons": "node scripts/brand-icons.mjs",
    "regions:data": "node scripts/generate-regions.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:api:migrate": "node scripts/dev-api.mjs migrate",
    "dev:cert": "node scripts/dev-cert.mjs",
    "dev:infra": "docker compose up -d --wait --wait-timeout 120 db mailpit minio minio-init storage certificates",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "vitest run --config vitest.config.ts",
    "test:db": "vitest run --config vitest.database.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
