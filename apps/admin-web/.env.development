# 只在开发模式中被载入
VITE_PORT = 8001

# 网站根目录
# 与生产构建一致使用 /admin/：开发服务器经裁判端 Vite 代理后与裁判端同源（https://localhost:8443/admin/），
# Cookie 会话才能共用；直接访问 http://localhost:8001/admin/ 也可独立调试。
VITE_PUBLIC_PATH = /admin/

# 是否开启 mock
VITE_USE_MOCK = true

# 是否开启控制台打印 mock 请求信息
VITE_LOGGER_MOCK = true

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理，可以配置多个，请注意不要换行
# 本机独立调试：把 /api 转发到本地 API。
VITE_PROXY = [["/api","http://localhost:3000/api"]]
#VITE_PROXY = [["/appApi","http://localhost:8001"],["/upload","http://localhost:8001/upload"]]
#VITE_PROXY=[["/api","https://naive-ui-admin"]]

# API 接口地址
VITE_GLOB_API_URL =

# 接口前缀
VITE_GLOB_API_URL_PREFIX = /api

# 文件上传地址
VITE_GLOB_UPLOAD_URL=

# 文件前缀地址
VITE_GLOB_FILE_URL=
