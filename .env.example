# 仅供本机 Docker 联调；复制为 .env 后替换占位值，不用于生产。
POSTGRES_PASSWORD=replace-with-a-random-local-password
AUTH_CHALLENGE_SECRET=replace-with-a-random-secret-at-least-32-bytes

WEB_PORT=8443
API_PORT=3000
POSTGRES_PORT=5432
MAILPIT_PORT=8025
# 宿主机直跑 API 时的 SMTP 端口（pnpm dev）；容器内仍使用 mailpit:1025。
MAILPIT_SMTP_PORT=1025
TEST_POSTGRES_PORT=5433

# 本地资源存储使用 pgsty/minio；三个密钥分别生成，勿使用生产数据。
MEDIA_ENABLED=true
MEDIA_STORAGE_PROVIDER=s3
MINIO_PORT=9443
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=refs-local-root
MINIO_ROOT_PASSWORD=replace-with-a-random-local-root-password
S3_ACCESS_KEY_ID=refs-local-media
S3_SECRET_ACCESS_KEY=replace-with-a-random-local-media-secret

# 上线选择 oss 时启用以下配置；S3 云服务配置见 apps/api/db/MEDIA_DEPLOYMENT.md。
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-private-bucket
OSS_ACCESS_KEY_ID=replace-in-deployment
OSS_ACCESS_KEY_SECRET=replace-in-deployment
MEDIA_EVENT_SECRET=replace-with-independent-random-secret-at-least-32-bytes
